#include <input/processors.dtsi>
#include <dt-bindings/zmk/input_transform.h>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>

// キー配置は ZEN (hayawo/zen-firmware config/keymap.keymap) に合わせている。
// 左手は左下から、右手は右下から揃えて配置。SIDE48 に入りきらない
// ZEN のキーは次の位置へ移している:
//   ZEN 左手 下から2段目の7列目 (&lt 3 PRINTSCREEN) -> 5方向スイッチの押し込み
//   ZEN 右手 下から2段目の1列目 (&lt 5 SCROLLLOCK) -> 左エンコーダーの押し込み
//   ZEN 左手 最下段の7列目 (TAB)                    -> 右手 最下段の1列目 (空き)
// 最上段 (5方向スイッチ / マウスボタン / エンコーダー押し込み) は SIDE48 独自。
//
// レイヤー: 0 BASE / 1 MOUSE (H 長押し) / 2 SYMBOL / 3 FUNC_NUM /
//           4 SCROLL_ARROW (T 長押しでトラックボールがスクロール) / 5 FUNCTION / 6 予備

// エンコーダーのスクロール量 (LiTom と同じ)
#undef ZMK_POINTING_DEFAULT_SCRL_VAL
#define ZMK_POINTING_DEFAULT_SCRL_VAL 80

&mt {
    flavor = "balanced";
    quick-tap-ms = <0>;
};

/ {
    combos {
        compatible = "zmk,combos";

        // ZEN と同じ: SYMBOL レイヤーで V + ; 同時押しで BT_CLR
        bt_clear {
            bindings = <&bt BT_CLR>;
            key-positions = <37 38>;
            layers = <2>;
        };
    };

    behaviors {
        // エンコーダー: LiTom と同じく時計回りで下スクロール、反時計回りで上。
        scroll_up_down: behavior_sensor_rotate_mouse_wheel_up_down {
            compatible = "zmk,behavior-sensor-rotate";
            #sensor-binding-cells = <0>;
            bindings = <&msc SCRL_DOWN>, <&msc SCRL_UP>;
            tap-ms = <20>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        layer_0 {
            display-name = "BASE";
            bindings = <
&kp UP                &kp RIGHT             &kp LEFT              &kp DOWN              &lt 3 PRINTSCREEN     &lt 5 SCROLLLOCK      &mkp MB1              &mkp MB2              &mkp MB3
&kp ESC               &kp Q                 &kp L                 &kp U                 &kp COMMA             &kp PERIOD            &kp F                 &kp W                 &kp R                 &kp Y                 &kp P                 &kp EQUAL
&kp LEFT_CONTROL      &kp E                 &kp I                 &kp A                 &kp O                 &kp MINUS             &kp K                 &lt 4 T               &kp N                 &kp S                 &lt 1 H               &kp ENTER
&kp LSHFT             &kp Z                 &kp X                 &kp C                 &kp V                 &kp SEMICOLON         &kp G                 &kp D                 &kp M                 &kp J                 &lt 5 B               &kp NON_US_BACKSLASH
&kp GRAVE             &kp LEFT_WIN          &kp SLASH             &kp LEFT_ALT          &kp SPACE             &mo 2                 &kp TAB               &kp BACKSPACE         &mo 4                 &kp HOME              &kp END               &kp SQT
            >;
            sensor-bindings = <&scroll_up_down &scroll_up_down>;
        };

        layer_1 {
            display-name = "MOUSE";
            bindings = <
&trans                 &trans                 &trans                 &trans                 &trans                 &trans                 &trans                 &trans                 &trans
&trans                 &trans                 &trans                 &trans                 &trans                 &trans                 &trans                 &mkp LCLK              &mo 4                  &mkp RCLK              &trans                 &trans
&trans                 &trans                 &trans                 &trans                 &trans                 &trans                 &kp RG(LEFT_BRACKET)   &mkp MB1               &mkp MB3               &mkp MB2               &kp RG(RIGHT_BRACKET)  &trans
&trans                 &trans                 &trans                 &trans                 &trans                 &trans                 &kp LC(UP_ARROW)       &mkp MB4               &trans                 &mkp MB5               &trans                 &trans
&trans                 &trans                 &trans                 &trans                 &trans                 &trans                 &trans                 &trans                 &trans                 &trans                 &trans                 &trans
            >;
            sensor-bindings = <&scroll_up_down &scroll_up_down>;
        };

        layer_2 {
            display-name = "SYMBOL";
            bindings = <
&trans                 &trans                 &trans                 &trans                 &trans                 &trans                 &trans                 &trans                 &trans
&kp ESCAPE             &kp N1                 &kp N2                 &kp N3                 &kp N4                 &kp N5                 &kp N6                 &kp N7                 &kp N8                 &kp N9                 &kp N0                 &kp DELETE
&trans                 &kp EXCL               &kp AT                 &kp HASH               &kp DOLLAR             &kp PRCNT              &kp CARET              &kp AMPERSAND          &kp ASTRK              &kp LEFT_PARENTHESIS   &kp RIGHT_PARENTHESIS  &trans
&trans                 &trans                 &trans                 &trans                 &trans                 &kp QUESTION           &kp TILDE              &kp LEFT_BRACE         &kp RIGHT_BRACE        &kp LEFT_BRACKET       &kp RIGHT_BRACKET      &kp SLASH
&trans                 &trans                 &trans                 &trans                 &trans                 &trans                 &trans                 &kp DEL                &trans                 &trans                 &trans                 &trans
            >;
            sensor-bindings = <&scroll_up_down &scroll_up_down>;
        };

        layer_3 {
            display-name = "FUNC_NUM";
            bindings = <
&trans           &trans           &trans           &trans           &bt BT_CLR_ALL   &kp SCROLLLOCK   &trans           &trans           &bootloader
&trans           &kp F1           &kp F2           &kp F3           &kp F4           &kp F5           &trans           &kp FSLH         &kp ASTRK        &kp KP_NUMBER_7  &kp KP_NUMBER_8  &kp KP_NUMBER_9
&trans           &kp F6           &kp F7           &kp F8           &kp F9           &kp F10          &kp HOME         &trans           &kp MINUS        &kp KP_NUMBER_4  &kp KP_NUMBER_5  &kp KP_NUMBER_6
&trans           &kp F11          &kp F12          &out OUT_USB     &out OUT_BLE     &bt BT_NXT       &kp END          &trans           &kp GRAVE        &kp KP_NUMBER_1  &kp KP_NUMBER_2  &kp KP_NUMBER_3
&bt BT_SEL 0     &bt BT_SEL 1     &bt BT_SEL 2     &bt BT_SEL 3     &bt BT_SEL 4     &trans           &trans           &trans           &trans           &kp KP_NUMBER_0  &kp DOT          &kp EQUAL
            >;
            sensor-bindings = <&scroll_up_down &scroll_up_down>;
        };

        layer_4 {
            display-name = "SCROLL_ARROW";
            bindings = <
&trans           &trans           &trans           &trans           &trans           &kp SCROLLLOCK   &trans           &trans           &trans
&trans           &trans           &trans           &trans           &trans           &trans           &trans           &trans           &trans           &trans           &trans           &trans
&trans           &trans           &trans           &trans           &trans           &trans           &trans           &kt HOME         &trans           &trans           &trans           &trans
&trans           &trans           &trans           &trans           &trans           &trans           &trans           &kp END          &trans           &kp HOME         &kp UP_ARROW     &kp END
&trans           &trans           &trans           &trans           &trans           &trans           &trans           &trans           &trans           &kp LEFT_ARROW   &kp DOWN_ARROW   &kp RIGHT_ARROW
            >;
            sensor-bindings = <&scroll_up_down &scroll_up_down>;
        };

        layer_5 {
            display-name = "FUNCTION";
            bindings = <
&trans   &trans   &trans   &trans   &trans   &trans   &trans   &trans   &trans
&kp ESC  &kp F1   &kp F2   &kp F3   &kp F4   &kp F5   &kp F6   &kp F7   &kp F8   &kp F9   &kp F10  &kp F12
&trans   &trans   &trans   &trans   &trans   &trans   &trans   &trans   &trans   &trans   &trans   &trans
&trans   &trans   &trans   &trans   &trans   &trans   &trans   &trans   &trans   &trans   &trans   &trans
&trans   &trans   &trans   &trans   &trans   &trans   &trans   &trans   &trans   &trans   &trans   &trans
            >;
            sensor-bindings = <&scroll_up_down &scroll_up_down>;
        };

        layer_6 {
            display-name = "SPARE";
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
            >;
            sensor-bindings = <&scroll_up_down &scroll_up_down>;
        };
    };
};
